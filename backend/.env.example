# Copy to backend/.env and fill in your own values.
# Note: keep the sslmode key intact (sslmode=require / sslmode=verify-full) —
# without it the pg driver connects without SSL and managed providers reject it.

# Used by the running app. On a managed Postgres with connection pooling
# (Neon, Supabase) point this at the POOLED endpoint — serverless instances
# open a new pool each and exhaust direct connections otherwise.
DATABASE_URL="postgresql://user:password@host-pooler.example.neon.tech/db?sslmode=verify-full"

# Used by prisma migrate only. Must be the DIRECT endpoint: a pooler in
# transaction mode cannot carry the statements migrations issue. Optional —
# falls back to DATABASE_URL when unset.
DIRECT_URL="postgresql://user:password@host.example.neon.tech/db?sslmode=verify-full"

# Optional — defaults are 3001 / 0.0.0.0
# PORT=3001
# HOST=0.0.0.0

# Comma-separated list of allowed browser origins.
# Defaults to https://hob-frontend-jet.vercel.app
# CORS_ORIGIN="https://hob-frontend-jet.vercel.app,http://localhost:5173"
