// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  name         String?
  password     String
  sessions     Session[]
  applications Application[]
}

model Session {
  id Int @id @default(autoincrement())

  /// SHA-256 of the token handed to the browser — a database leak must not
  /// hand over live sessions. The raw token exists only in the cookie.
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  /// Reached only from OFFER, by the detail page's "Accept offer" action —
  /// the one positive terminal outcome, kept apart from REJECTED/WITHDRAWN
  /// so the board's Archive tab and analytics' rejection rate never count a
  /// won offer as a loss.
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum WorkFormat {
  REMOTE
  HYBRID
  ONSITE
}

enum SalaryType {
  GROSS
  NET
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

/// One job application, owned by the user who created it. Every route reaches
/// it through userId — there is no sharing in this phase.
model Application {
  id       Int               @id @default(autoincrement())
  userId   Int
  company  String
  position String
  status   ApplicationStatus @default(APPLIED)

  /// How much this one is worth chasing relative to the rest of the board —
  /// entirely the applicant's own call, nothing derived. Defaults to MEDIUM
  /// rather than being nullable: the board reads this as a permanent
  /// left-edge stripe on every card (see ApplicationCardVisual), and a
  /// fourth "unset" stripe color would just be a paler way of saying
  /// "medium" without actually meaning anything different.
  priority Priority @default(MEDIUM)

  /// Who you actually talked to there — a name, not an account. The same
  /// company can resurface a year later through a different person, and
  /// "who was it last time" is exactly the thing memory fails at; this is
  /// the durable answer. Free text, not a contacts table: there is nothing
  /// here to relate across applications, only something to remember within
  /// one.
  recruiter String?

  /// Whole currency units, as advertised. Still no currency field: the UI
  /// only ever shows one fixed symbol ($) rather than a real per-application
  /// unit, so a currency column would just store the same constant on every
  /// row — additive to add later, once the app actually needs more than one.
  salary     Int?
  salaryType SalaryType?
  workFormat WorkFormat?
  jobUrl     String?

  /// Free text — "Referral", "Company site", "LinkedIn" — not an enum: the
  /// set of channels someone applies through is open-ended and personal. A
  /// Postgres text array rather than one string: a single application can
  /// legitimately have found its way through more than one channel (e.g. a
  /// referral who pointed at a listing also seen on LinkedIn), and analytics'
  /// bySource breakdown counts a multi-source application toward every
  /// channel it lists, same fan-out as byRole would if position ever became
  /// multi-valued.
  source String[] @default([])

  /// Only meaningful once status is OFFER; null the rest of the time. Kept
  /// as its own field rather than folded into notes so the board and the
  /// detail page can read it structurally (a countdown, not free text).
  offerDeadline DateTime?

  /// Free-form tags entered on the create form ("Remote", "Referral").
  /// A Postgres text array, not a join table — nobody reorders or renames a
  /// tag across applications here, so the relational overhead buys nothing.
  labels String[] @default([])

  /// Short summary of the posting, kept because listings disappear.
  summary String?
  notes   String?

  appliedDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews    Interview[]
  attachments   Attachment[]
  statusChanges StatusChange[]

  /// The list route reads one user's applications newest first.
  @@index([userId, appliedDate])
  @@index([userId, status])
}

model Interview {
  id            Int @id @default(autoincrement())
  applicationId Int

  /// Free text rather than an enum: rounds are named differently at every
  /// company, and an enum would need a migration per new name.
  round       String
  scheduledAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

/// One row per status transition, written in the same transaction as the
/// change that causes it — this is the audit trail the analytics page reads
/// average time-per-stage from, not something reconstructed after the fact.
model StatusChange {
  id            Int @id @default(autoincrement())
  applicationId Int

  /// Null only for the row written at creation: there is no "from" status
  /// before an application exists.
  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus
  changedAt  DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// Read per application, oldest first — that order is what turns consecutive
  /// rows into "time spent in a stage".
  @@index([applicationId, changedAt])
}

model Attachment {
  id            Int @id @default(autoincrement())
  applicationId Int

  /// Where the file lives in Vercel Blob. Also what deletion is issued against.
  blobUrl    String
  fileName   String
  uploadedAt DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}
