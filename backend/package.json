    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@hob/shared": "*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^7.0.0",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.20.3",
    "vitest": "^4.1.10"
  }
