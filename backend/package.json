{
  "name": "@hob/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "start": "node dist/index.js",
    "clean": "tsc --build --clean",
    "prisma": "prisma",
    "db:generate": "prisma generate",
