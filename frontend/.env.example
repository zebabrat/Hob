# Copy to frontend/.env.local and fill in if the backend lives on another origin.
#
# Leave it unset for local development: requests go to /api and the Vite dev
# proxy (see vite.config.ts) forwards them to http://localhost:3001.
#
# Only variables prefixed with VITE_ reach the browser bundle — never put
# secrets here, the value ends up in the published JavaScript.
# VITE_API_URL="https://api.example.com"
